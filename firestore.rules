rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email.lower() == 'dwiki223@guru.smp.belajar.id';
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // Validation Blueprints (Synchronized verbatim with firebase-blueprint.json)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role in ['member', 'admin'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDriveExcelLink(data) {
      return data.keys().hasAll([
          'ownerId',
          'driveFileId',
          'fileName',
          'webViewLink',
          'lastTotalVoters',
          'lastTotalSelections',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'driveFileId',
          'fileName',
          'webViewLink',
          'lastTotalVoters',
          'lastTotalSelections',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.driveFileId is string && data.driveFileId.size() >= 1 && data.driveFileId.size() <= 200 &&
        data.driveFileId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160 &&
        data.webViewLink is string && data.webViewLink.size() <= 500 &&
        data.lastTotalVoters is int && data.lastTotalVoters >= 0 &&
        data.lastTotalSelections is int && data.lastTotalSelections >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRecapSnapshot(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'totalVoters',
          'totalSelections',
          'activeClassesCount',
          'topTeacherName',
          'topTeacherVotes',
          'driveFileName',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'title',
          'totalVoters',
          'totalSelections',
          'activeClassesCount',
          'topTeacherName',
          'topTeacherVotes',
          'driveFileName',
          'createdAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.totalVoters is int && data.totalVoters >= 0 &&
        data.totalSelections is int && data.totalSelections >= 0 &&
        data.activeClassesCount is int && data.activeClassesCount >= 0 && data.activeClassesCount <= 14 &&
        data.topTeacherName is string && data.topTeacherName.size() <= 120 &&
        data.topTeacherVotes is int && data.topTeacherVotes >= 0 &&
        data.driveFileName is string && data.driveFileName.size() <= 160 &&
        data.createdAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role == 'member' || (incoming().role == 'admin' && isAdmin()));

      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        (isOwner(userId) || isAdmin()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'role', 'updatedAt'])) ||
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']))
        );

      allow delete: if false;

      // Subcollection: /users/{userId}/driveLinks/{linkId}
      match /driveLinks/{linkId} {
        allow get: if isValidId(userId) && isValidId(linkId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid && request.auth.uid == userId;

        allow create: if isValidId(userId) &&
          isValidId(linkId) &&
          isOwner(userId) &&
          isValidDriveExcelLink(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().ownerId == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isValidId(userId) &&
          isValidId(linkId) &&
          isValidDriveExcelLink(incoming()) &&
          (isOwner(userId) || isAdmin()) &&
          parentUserExists(userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'driveFileId',
            'fileName',
            'webViewLink',
            'lastTotalVoters',
            'lastTotalSelections',
            'updatedAt'
          ]);

        allow delete: if isValidId(userId) &&
          isValidId(linkId) &&
          (isOwner(userId) || isAdmin()) &&
          parentUserExists(userId);
      }

      // Subcollection: /users/{userId}/recapSnapshots/{snapshotId}
      match /recapSnapshots/{snapshotId} {
        allow get: if isValidId(userId) && isValidId(snapshotId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid && request.auth.uid == userId;

        allow create: if isValidId(userId) &&
          isValidId(snapshotId) &&
          isOwner(userId) &&
          isValidRecapSnapshot(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().ownerId == userId &&
          incoming().createdAt == request.time &&
          parentUserExists(userId);

        allow update: if false;

        allow delete: if isValidId(userId) &&
          isValidId(snapshotId) &&
          (isOwner(userId) || isAdmin()) &&
          parentUserExists(userId);
      }
    }

    function isValidClassCode(cls) {
      return cls is string &&
        cls in ['71', '72', '73', '74', '81', '82', '83', '84', '85', '91', '92', '93', '94', '95'];
    }

    function hasAllTeacherSelections(sel) {
      return sel is map &&
        sel.size() == 28 &&
        sel.keys().hasAll([
          't-01', 't-02', 't-03', 't-04', 't-05', 't-06', 't-07',
          't-08', 't-09', 't-10', 't-11', 't-12', 't-13', 't-14',
          't-15', 't-16', 't-17', 't-18', 't-19', 't-20', 't-21',
          't-22', 't-23', 't-24', 't-25', 't-26', 't-27', 't-28'
        ]) &&
        sel.keys().hasOnly([
          't-01', 't-02', 't-03', 't-04', 't-05', 't-06', 't-07',
          't-08', 't-09', 't-10', 't-11', 't-12', 't-13', 't-14',
          't-15', 't-16', 't-17', 't-18', 't-19', 't-20', 't-21',
          't-22', 't-23', 't-24', 't-25', 't-26', 't-27', 't-28'
        ]) &&
        sel['t-01'] is string && sel['t-01'].size() >= 4 && sel['t-01'].size() <= 8 &&
        sel['t-02'] is string && sel['t-02'].size() >= 4 && sel['t-02'].size() <= 8 &&
        sel['t-03'] is string && sel['t-03'].size() >= 4 && sel['t-03'].size() <= 8 &&
        sel['t-04'] is string && sel['t-04'].size() >= 4 && sel['t-04'].size() <= 8 &&
        sel['t-05'] is string && sel['t-05'].size() >= 4 && sel['t-05'].size() <= 8 &&
        sel['t-06'] is string && sel['t-06'].size() >= 4 && sel['t-06'].size() <= 8 &&
        sel['t-07'] is string && sel['t-07'].size() >= 4 && sel['t-07'].size() <= 8 &&
        sel['t-08'] is string && sel['t-08'].size() >= 4 && sel['t-08'].size() <= 8 &&
        sel['t-09'] is string && sel['t-09'].size() >= 4 && sel['t-09'].size() <= 8 &&
        sel['t-10'] is string && sel['t-10'].size() >= 4 && sel['t-10'].size() <= 8 &&
        sel['t-11'] is string && sel['t-11'].size() >= 4 && sel['t-11'].size() <= 8 &&
        sel['t-12'] is string && sel['t-12'].size() >= 4 && sel['t-12'].size() <= 8 &&
        sel['t-13'] is string && sel['t-13'].size() >= 4 && sel['t-13'].size() <= 8 &&
        sel['t-14'] is string && sel['t-14'].size() >= 4 && sel['t-14'].size() <= 8 &&
        sel['t-15'] is string && sel['t-15'].size() >= 4 && sel['t-15'].size() <= 8 &&
        sel['t-16'] is string && sel['t-16'].size() >= 4 && sel['t-16'].size() <= 8 &&
        sel['t-17'] is string && sel['t-17'].size() >= 4 && sel['t-17'].size() <= 8 &&
        sel['t-18'] is string && sel['t-18'].size() >= 4 && sel['t-18'].size() <= 8 &&
        sel['t-19'] is string && sel['t-19'].size() >= 4 && sel['t-19'].size() <= 8 &&
        sel['t-20'] is string && sel['t-20'].size() >= 4 && sel['t-20'].size() <= 8 &&
        sel['t-21'] is string && sel['t-21'].size() >= 4 && sel['t-21'].size() <= 8 &&
        sel['t-22'] is string && sel['t-22'].size() >= 4 && sel['t-22'].size() <= 8 &&
        sel['t-23'] is string && sel['t-23'].size() >= 4 && sel['t-23'].size() <= 8 &&
        sel['t-24'] is string && sel['t-24'].size() >= 4 && sel['t-24'].size() <= 8 &&
        sel['t-25'] is string && sel['t-25'].size() >= 4 && sel['t-25'].size() <= 8 &&
        sel['t-26'] is string && sel['t-26'].size() >= 4 && sel['t-26'].size() <= 8 &&
        sel['t-27'] is string && sel['t-27'].size() >= 4 && sel['t-27'].size() <= 8 &&
        sel['t-28'] is string && sel['t-28'].size() >= 4 && sel['t-28'].size() <= 8;
    }

    function isValidBallot(data) {
      return data.keys().hasAll([
          'id',
          'schemaVersion',
          'voterName',
          'normalizedVoterKey',
          'voterClass',
          'selections',
          'submittedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'schemaVersion',
          'voterName',
          'normalizedVoterKey',
          'voterClass',
          'selections',
          'submittedAt'
        ]) &&
        isValidId(data.id) &&
        data.schemaVersion is int && data.schemaVersion == 1 &&
        data.voterName is string && data.voterName.size() >= 2 && data.voterName.size() <= 100 &&
        data.normalizedVoterKey is string && data.normalizedVoterKey.size() >= 6 && data.normalizedVoterKey.size() <= 110 &&
        isValidClassCode(data.voterClass) &&
        hasAllTeacherSelections(data.selections) &&
        data.submittedAt is timestamp;
    }

    // Collection: /ballots/{ballotId} (Public voting submissions & real-time live recap)
    match /ballots/{ballotId} {
      allow get: if isValidId(ballotId);
      allow list: if resource.data.schemaVersion == 1;

      allow create: if isValidId(ballotId) &&
        isValidBallot(incoming()) &&
        incoming().id == ballotId &&
        incoming().submittedAt == request.time;

      allow update: if false;
      allow delete: if isValidId(ballotId) && isAdmin();
    }
  }
}
